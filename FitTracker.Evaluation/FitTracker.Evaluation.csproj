<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FitBot NON-RAG baseline evaluator. Production kodunu DEĞİŞTİRMEZ: API projesini referans alır ve production DI
    kayıtlarını (AddGroqSemanticKernel, AddFitBotWorkoutPlugin, AddFitBotWorkoutPlanPlugin, AiWorkoutCoachService)
    izole bir SQLite fixture veritabanı üzerinde aynen kullanır. Yalnızca ölçüm amaçlı enstrümantasyon ekler
    (HTTP kayıt handler'ı ve tool-invocation kayıt filtresi).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FitTracker.Evaluation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- API projesi Sdk.Web olduğu için ASP.NET Core shared framework gerekir (user-secrets dahil). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FitTracker.API\FitTrackr.API.csproj" />
  </ItemGroup>

</Project>
